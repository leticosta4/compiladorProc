prot fatorial (&int, int)  //também funciona caso eu apague (por enquanto ok, mas pode mudar dps das regras semanticas) 

def init 
    int n, fat 
    getint n 
    do fatorial(fat, n) 
    putint fat 
endp 

def fatorial(&int f, int n) 
    if (n <= 1) f = 1 
    else 
        do fatorial(f, n-1) 
        f = f * n 
    endi 
endp 